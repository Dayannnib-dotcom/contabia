{
  "name": "contabia",
  "private": true,
  "version": "0.1.0",
  "description": "Contabia — plataforma de faturação, contabilidade SNC e SAF-T para empresas em Portugal",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "npm run dev -w @contabia/server",
    "empresa": "npm run start -w @contabia/empresa",
    "contabilista": "npm run start -w @contabia/contabilista",
    "test": "npm test -w @contabia/shared && npm test -w @contabia/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
