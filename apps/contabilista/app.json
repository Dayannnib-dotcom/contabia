{
  "expo": {
    "name": "Contabia Contabilista",
    "slug": "contabia-contabilista",
    "scheme": "contabia-cc",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#12232E",
    "ios": { "bundleIdentifier": "pt.contabia.contabilista", "supportsTablet": true },
