# Copie para .env e preencha.

# Servidor
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
POSTGRES_PASSWORD=troque-esta-senha
# Token para publicar novas versões das regras fiscais (POST /v1/admin/regras)
ADMIN_TOKEN=troque-este-token
# Opcional: ativa o Luís com IA (sem chave, responde por regras locais)
ANTHROPIC_API_KEY=

# Apps (Expo) — endereço do servidor visto pelo telemóvel
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
